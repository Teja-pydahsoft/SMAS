# Caddy automatically obtains and renews a Let's Encrypt certificate for
# {$DOMAIN}. HTTPS is required — browsers only allow camera access (gate
# scanner) on secure origins.

{$DOMAIN} {
	encode gzip

	# API and uploaded photos go straight to the Express backend,
	# bypassing the Next.js rewrite proxy entirely.
	handle /api/* {
		# Vehicle ANPR can take 1–3 minutes on CPU. Default Caddy header timeout
		# would otherwise cut the request and the portal shows a 500.
		reverse_proxy backend:3001 {
			transport http {
				dial_timeout 10s
				response_header_timeout 180s
				read_timeout 180s
				write_timeout 180s
			}
		}
	}

	handle /uploads/* {
		reverse_proxy backend:3001
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy frontend:3000
	}
}
